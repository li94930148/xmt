# 本地开发后端端口
PORT=3001
HOST=127.0.0.1

# 本地开发 JWT 密钥。不要把正式环境密钥写入本仓库。
# 可以使用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-local-development-secret-key-here

# Auth v1 experimental HTTP adapter. It is off by default and is forcibly disabled
# when NODE_ENV=production. Never reuse JWT_SECRET as the refresh-token pepper.
XMT_AUTH_V1_ENABLED=false
XMT_AUTH_REFRESH_PEPPER=
JWT_V1_ISSUER=xmt-api
JWT_V1_AUDIENCE=xmt-clients
# Web Auth migration infrastructure remains off by default.
# Allowlist values are positive numeric user IDs separated by commas.
XMT_AUTH_WEB_ENABLED=false
XMT_AUTH_WEB_ALLOWLIST_USER_IDS=
# Unified rollout mode: disabled | legacy | internal | allowlist | percentage.
# When omitted, the legacy XMT_AUTH_V1_ENABLED + XMT_AUTH_WEB_ENABLED pair is
# translated to allowlist mode for backward compatibility. Production only accepts
# allowlist when the separately reviewed approval switch is true.
XMT_AUTH_ROLLOUT_MODE=legacy
XMT_AUTH_ROLLOUT_APPROVED=false
XMT_AUTH_ROLLOUT_INTERNAL_USER_IDS=
XMT_AUTH_ROLLOUT_PERCENTAGE=0
# Non-secret salt used only to keep percentage allocation stable across instances.
XMT_AUTH_ROLLOUT_HASH_SALT=xmt-auth-rollout-v1
# Read-only governance stop thresholds. Exceeding them emits risk events only;
# it never mutates rollout configuration automatically.
XMT_AUTH_ROLLOUT_THRESHOLD_WINDOW_MINUTES=60
XMT_AUTH_ROLLOUT_MAX_REFRESH_FAILURE_RATE=0.2
XMT_AUTH_ROLLOUT_MAX_CSRF_FAILURES=5
XMT_AUTH_ROLLOUT_MAX_TOKEN_REUSE=1
XMT_AUTH_ROLLOUT_MAX_EXPIRED=10
# Required only when the non-production Web Auth adapter is explicitly enabled.
# Do not reuse JWT or refresh pepper keys.
XMT_AUTH_CSRF_SECRET=
XMT_AUTH_WEB_ORIGINS=http://localhost:5173
XMT_AUTH_COOKIE_SECURE=false

# Auth Prometheus scrape endpoint. Keep disabled until the reverse proxy/firewall
# blocks public access and the exact monitoring-network CIDRs are reviewed.
XMT_AUTH_METRICS_HTTP_ENABLED=false
XMT_AUTH_METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Stable, non-secret process identity used only as a low-cardinality metric label.
XMT_INSTANCE_ID=xmt-local-1

# Douyin Open Platform — keep real values in deployment secret storage.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_WEBHOOK_URL=
# Set only after Webhook capability is enabled in the Douyin console.
DOUYIN_WEBHOOK_SECRET=
# Configure only with the exact approved OpenAPI endpoint documented for this app.

# Production topology is client -> Caddy -> Node, so trust one proxy hop only.
TRUST_PROXY=1

# Shared office egress IP-safe API rate limit. Invalid values fall back to these defaults.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200

LOGIN_IP_RATE_LIMIT_ENABLED=true
LOGIN_IP_RATE_LIMIT_WINDOW_MS=300000
LOGIN_IP_RATE_LIMIT_MAX=100
LOGIN_ACCOUNT_RATE_LIMIT_ENABLED=true
LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
LOGIN_ACCOUNT_RATE_LIMIT_MAX=15

RATE_LIMIT_DIAGNOSTICS=false

# 局域网内其他前端地址，逗号分隔
# CORS_ORIGINS=http://192.168.1.100:5174,http://192.168.1.101:5174
# Optional Douyin account-level data endpoints (official defaults are used when omitted)
